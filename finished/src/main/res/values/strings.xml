    <string name="body_fat_readings"> Body Fat Readings </string>
    <string name="weight_readings_empty">No weight readings found</string>
    <string name="body_fat_readings_empty">No body fat readings found</string>

    <!-- Health Connect settings -->
    <string name="settings">Settings</string>
