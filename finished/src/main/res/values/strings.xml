<resources>
    <string name="app_name">Health Connect Codelab</string>
    <string name="menu">menu</string>

    <!-- Welcome screen -->
    <string name="health_connect_logo">Health Connect logo</string>
    <string name="installed_welcome_message">
        Health Connect is installed on this device. Use the menu to explore the sample, with each
